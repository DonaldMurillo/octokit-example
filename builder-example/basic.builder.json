{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Basic Example",
  "description": "A simple schema with basic data types",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier"
    },
    "name": {
      "type": "string",
      "description": "Name of the item"
    },
    "active": {
      "type": "boolean",
      "description": "Whether the item is active"
    },
    "tags": {
      "type": "array",
      "description": "List of tags",
      "items": {
        "type": "string"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
