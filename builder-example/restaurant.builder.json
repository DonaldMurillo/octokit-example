{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Restaurant",
  "description": "A schema representing a restaurant with various data types",
  "type": "object",
  "required": ["name", "address", "rating", "isOpen"],
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the restaurant",
      "minLength": 1,
      "maxLength": 100
    },
    "address": {
      "type": "object",
      "required": ["street", "city", "country", "zipCode"],
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "zipCode": {
          "type": "string",
          "pattern": "^[0-9]{5}(-[0-9]{4})?$"
        }
      }
    },
    "coordinates": {
      "type": "object",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "rating": {
      "type": "number",
      "description": "Restaurant rating out of 5",
      "minimum": 0,
      "maximum": 5
    },
    "reviewCount": {
      "type": "integer",
      "description": "Total number of reviews",
      "minimum": 0
    },
    "priceRange": {
      "type": "string",
      "enum": ["$", "$$", "$$$", "$$$$"],
      "description": "Price range indicator"
    },
    "cuisine": {
      "type": "array",
      "description": "Types of cuisine served",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "isOpen": {
      "type": "boolean",
      "description": "Whether the restaurant is currently open"
    },
    "openingHours": {
      "type": "object",
      "properties": {
        "monday": { "$ref": "#/definitions/daySchedule" },
        "tuesday": { "$ref": "#/definitions/daySchedule" },
        "wednesday": { "$ref": "#/definitions/daySchedule" },
        "thursday": { "$ref": "#/definitions/daySchedule" },
        "friday": { "$ref": "#/definitions/daySchedule" },
        "saturday": { "$ref": "#/definitions/daySchedule" },
        "sunday": { "$ref": "#/definitions/daySchedule" }
      }
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+?[1-9]\\d{1,14}$"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "capacity": {
      "type": "integer",
      "description": "Maximum seating capacity",
      "minimum": 1
    },
    "amenities": {
      "type": "array",
      "description": "Available amenities",
      "items": {
        "type": "string",
        "enum": [
          "WiFi",
          "Parking",
          "Outdoor Seating",
          "Delivery",
          "Takeout",
          "Reservations",
          "Wheelchair Accessible",
          "Pet Friendly"
        ]
      },
      "uniqueItems": true
    },
    "menu": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/menuItem"
      }
    },
    "established": {
      "type": "string",
      "format": "date",
      "description": "Date the restaurant was established"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "daySchedule": {
      "type": "object",
      "properties": {
        "open": {
          "type": "string",
          "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
        },
        "close": {
          "type": "string",
          "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
        },
        "closed": {
          "type": "boolean"
        }
      }
    },
    "menuItem": {
      "type": "object",
      "required": ["name", "price"],
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "enum": ["Appetizer", "Entree", "Dessert", "Beverage", "Side"]
        },
        "vegetarian": {
          "type": "boolean"
        },
        "vegan": {
          "type": "boolean"
        },
        "glutenFree": {
          "type": "boolean"
        },
        "spicyLevel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    }
  }
}